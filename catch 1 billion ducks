-- Перетаскивание интерфейса пальцем/мышкой
local dragging, dragInput, dragStart, startPos
local function update(input)
    local delta = input.Position - dragStart
    MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end
MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
MainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)
UIS.InputChanged:Connect(function(input)
    if input == dragInput and dragging then update(input) end
end)

-- Ультра-плавная 5-секундная Анимация Появления (Intro)
task.spawn(function()
    local tInfo = TweenInfo.new(1, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    
    -- Текст проявляется со сдвигом вверх
    IntroText.Position = UDim2.new(0, 0, 0, 20)
    TweenService:Create(IntroText, tInfo, {TextTransparency = 0, Position = UDim2.new(0, 0, 0, 0)}):Play()
    
    -- Бегущая лазерная линия сканирования (Цикл внутри заставки)
    task.spawn(function()
        for i = 1, 3 do
            ScanLine.Position = UDim2.new(0, 0, 0, -2)
            TweenService:Create(ScanLine, TweenInfo.new(1.3, Enum.EasingStyle.Linear), {Position = UDim2.new(0, 0, 1, 0)}):Play()
            task.wait(1.4)
        end
    end)
    
    task.wait(4.1) -- Полное время заставки (в сумме 5 сек)
    
    -- Закрытие заставки
    local fadeInfo = TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    TweenService:Create(IntroText, fadeInfo, {TextTransparency = 1}):Play()
    TweenService:Create(IntroFrame, fadeInfo, {Size = UDim2.new(0, 320, 0, 0), Position = UDim2.new(0.5, -160, 0.5, 0)}):Play()
    TweenService:Create(IntroGlow, fadeInfo, {BackgroundTransparency = 1}):Play()
    task.wait(0.7)
    
    IntroFrame:Destroy()
    
    -- Плавное проявление главного меню из прозрачности
    MainFrame.Size = UDim2.new(0, 320, 0, 0)
    MainFrame.Visible = true
    TweenService:Create(MainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, 320, 0, 220)}):Play()
    
    -- Эффект пульсации неоновой рамки на фоне
    task.spawn(function()
        while MainFrame and MainFrame.Parent do
            TweenService:Create(FrameGlow, TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {BackgroundTransparency = 0.88}):Play()
            task.wait(1.5)
            TweenService:Create(FrameGlow, TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {BackgroundTransparency = 0.95}):Play()
            task.wait(1.5)
        end
    end)
end)

